generator cliente {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilAcesso {
  ADMINISTRADOR
  GERENTE
  CAIXA
  ATENDENTE
  GARCOM
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
  RESERVA
  LIBERACAO
}

model Empresa {
  id       String   @id @default(uuid()) @db.Uuid
  nome     String
  cnpj     String   @unique
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  usuarios             Usuario[]
  produtos             Produto[]
  categorias           Categoria[]
  unidades             Unidade[]
  saldosEstoque        SaldoEstoque[]
  movimentacoesEstoque MovimentacaoEstoque[]
}

model Usuario {
  id        String       @id @default(uuid()) @db.Uuid
  empresaId String       @db.Uuid
  nome      String
  email     String
  hashSenha String
  perfil    PerfilAcesso @default(CAIXA)
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, email])
  @@index([empresaId])
}

model Categoria {
  id             String  @id @default(uuid()) @db.Uuid
  empresaId      String  @db.Uuid
  nome           String
  categoriaPaiId String? @db.Uuid

  empresa Empresa @relation(fields: [empresaId], references: [id])

  categoriaPai  Categoria?  @relation("ArvoreCategorias", fields: [categoriaPaiId], references: [id])
  subcategorias Categoria[] @relation("ArvoreCategorias")

  @@unique([empresaId, id])
  @@index([empresaId, categoriaPaiId])
}

model Unidade {
  id        String @id @default(uuid()) @db.Uuid
  empresaId String @db.Uuid
  codigo    String
  nome      String

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, codigo])
}

model Produto {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @db.Uuid
  nome         String
  sku          String
  descricao    String?
  categoriaId  String?  @db.Uuid
  unidadeId    String?  @db.Uuid
  codigoBarras String?
  preco        Decimal  @db.Decimal(12, 2)
  custo        Decimal  @db.Decimal(12, 2)
  perecivel    Boolean  @default(false)
  peso         Decimal? @db.Decimal(12, 3)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  saldoEstoque  SaldoEstoque?
  movimentacoes MovimentacaoEstoque[]

  @@unique([empresaId, id])
  @@unique([empresaId, sku])
  @@index([empresaId, nome])
  @@index([empresaId, codigoBarras])
}

model SaldoEstoque {
  id                   String   @id @default(uuid()) @db.Uuid
  empresaId            String   @db.Uuid
  produtoId            String   @unique @db.Uuid
  quantidadeDisponivel Decimal  @default(0) @db.Decimal(14, 3)
  quantidadeReservada  Decimal  @default(0) @db.Decimal(14, 3)
  atualizadoEm         DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([empresaId])
}

model MovimentacaoEstoque {
  id           String           @id @default(uuid()) @db.Uuid
  empresaId    String           @db.Uuid
  produtoId    String           @db.Uuid
  tipo         TipoMovimentacao
  quantidade   Decimal          @db.Decimal(14, 3)
  saldoApos    Decimal          @db.Decimal(14, 3)
  motivo       String
  referenciaId String?
  usuarioId    String           @db.Uuid
  criadoEm     DateTime         @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([empresaId, produtoId, criadoEm])
}
